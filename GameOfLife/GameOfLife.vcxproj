      <LinkObjects>false</LinkObjects>
    </CustomBuild>
    <CustomBuild Include="GameOfLife.hlsl">
      <Command>set "PATH=$(ExecutablePath)"
fxc.exe /nologo /T vs_4_0 /E VSMain /Fh "$(IntDir)GameOfLifeVS.h" /Fo "$(IntDir)GameOfLifeVS.cso" /Vn GameOfLifeVertexShader $(ShaderCompilerOptions) "%(FullPath)"
if errorlevel 1 exit /b %errorlevel%
fxc.exe /nologo /T ps_4_0 /E PSMain /Fh "$(IntDir)GameOfLifePS.h" /Fo "$(IntDir)GameOfLifePS.cso" /Vn GameOfLifePixelShader $(ShaderCompilerOptions) "%(FullPath)"
if errorlevel 1 exit /b %errorlevel%
fxc.exe /nologo /T ps_4_0 /E StepPS /Fh "$(IntDir)GameOfLifeStepPS.h" /Fo "$(IntDir)GameOfLifeStepPS.cso" /Vn GameOfLifeStepPixelShader $(ShaderCompilerOptions) "%(FullPath)"
if errorlevel 1 exit /b %errorlevel%
fxc.exe /nologo /T ps_4_0 /E ComparePS /Fh "$(IntDir)GameOfLifeComparePS.h" /Fo "$(IntDir)GameOfLifeComparePS.cso" /Vn GameOfLifeComparePixelShader $(ShaderCompilerOptions) "%(FullPath)"
if errorlevel 1 exit /b %errorlevel%</Command>
      <Message>Compiling shaders from GameOfLife.hlsl</Message>
      <Outputs>$(IntDir)GameOfLifeVS.h;$(IntDir)GameOfLifeVS.cso;$(IntDir)GameOfLifePS.h;$(IntDir)GameOfLifePS.cso;$(IntDir)GameOfLifeStepPS.h;$(IntDir)GameOfLifeStepPS.cso;$(IntDir)GameOfLifeComparePS.h;$(IntDir)GameOfLifeComparePS.cso</Outputs>
      <LinkObjects>false</LinkObjects>
    </CustomBuild>
