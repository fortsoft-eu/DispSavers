    <CustomBuild Include="LifePatterns.xml">
      <Command>"$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$(ProjectDir)prepare.ps1" -Source "%(FullPath)" -Output "$(IntDir)LifePatterns.packed" -Patterns</Command>
